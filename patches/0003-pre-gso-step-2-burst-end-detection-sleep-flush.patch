@@ -6430,6 +6431,17 @@ static inline void sched_submit_work(struct task_struct *tsk)
 	 */
 	if (blk_needs_flush_plug(tsk))
 		blk_schedule_flush_plug(tsk);
+
+	/*
+	 * Pre-GSO: a task that blocks has finished its message burst, so
+	 * commit the TCP batches it staged (aggregation_end).  Involuntary
+	 * preemption never gets here, so contention does not end a batch.
+	 * Like the block plug above, never do this while blocking on an
+	 * RT spinlock/rwlock substitute.
+	 */
+	if (tcp_pre_gso_needs_flush_plug(tsk) &&
+	    !(tsk->__state & TASK_RTLOCK_WAIT))
+		tcp_pre_gso_flush_plug(tsk);
 }
 
