     seq_printf(m, "committed_bytes %llu\n",
         (unsigned long long)atomic64_read(&pre_gso_dyn_stat_bytes));
     seq_printf(m, "committed_messages %llu\n",
@@ -1507,6 +1523,143 @@ static int tcp_pre_gso_grow_staging(struct sock *sk,
  * Successful return is the original byte count accepted into kernel memory;
  * no change to TCP's existing recv() byte-stream semantics is claimed.
  */
+/*
+ * Shared by every deferred committer (timer, sleep flush).  Returns true
+ * when a staged batch exists and may be committed.  Called under the TCP
+ * socket lock (bh_lock_sock with !owned, or from tcp_release_cb).
+ */
+static bool tcp_pre_gso_pending_committable(struct sock *sk)
+{
+    struct tcp_sock *tp = tcp_sk(sk);
+
+    if (!tp->pre_gso_skb)
+        return false;
+
+    /* Invariant: staged bytes share the fate of TCP write-queue bytes.
+     * TCP drops its write queue only when the connection is torn down
+     * (tcp_done / tcp_write_queue_purge / tcp_disconnect), never because
+     * sk_err is set on a still-usable connection.  Discarding here on
+     * sk_err alone would drop bytes already reported as sent while later
+     * bytes still go out, i.e. a silent hole in the byte stream.
+     */
+    if (sk->sk_state == TCP_CLOSE) {
+        tcp_pre_gso_discard_locked(sk);
+        return false;
+    }
+    /* tcp_shutdown() commits before the FIN is queued, so staged bytes
+     * can never coexist with SEND_SHUTDOWN.  If they do, appending them
+     * after the FIN sequence would corrupt the stream: drop and report.
+     */
+    if (WARN_ON_ONCE(sk->sk_shutdown & SEND_SHUTDOWN)) {
+        tcp_pre_gso_discard_locked(sk);
+        return false;
+    }
+    return true;
+}
+
+/* aggregation_end: the task that staged this batch went to sleep. */
+void tcp_pre_gso_flush_handler(struct sock *sk)
+{
+    if (!tcp_pre_gso_pending_committable(sk))
+        return;
+    atomic64_inc(&pre_gso_dyn_stat_sleep);
+    tcp_pre_gso_commit_locked(sk);
+}
+
+#define TCP_PRE_GSO_PLUG_INIT	8U
+#define TCP_PRE_GSO_PLUG_MAX	4096U
+
+/*
+ * Record @sk in current's plug so that the batch is committed when
+ * current blocks.  Process context, under lock_sock(sk).  Only current
+ * touches current->pre_gso_plug, so no lock is needed; a sleep inside
+ * krealloc() may run tcp_pre_gso_flush_plug() on the old buffer before it
+ * is copied, which is consistent because the copy happens afterwards.
+ * Returns false if the entry could not be recorded.
+ */
+static bool tcp_pre_gso_plug_add(struct sock *sk)
+{
+    struct tcp_sock *tp = tcp_sk(sk);
+    struct task_struct *tsk = current;
+    struct tcp_pre_gso_plug *plug;
+
+    if (READ_ONCE(tp->pre_gso_plug_owner) == tsk)
+        return true;
+
+    plug = tsk->pre_gso_plug;
+    if (!plug || plug->nr == plug->cap) {
+        unsigned int cap = plug ? plug->cap * 2 : TCP_PRE_GSO_PLUG_INIT;
+        struct tcp_pre_gso_plug *np;
+
+        if (cap > TCP_PRE_GSO_PLUG_MAX)
+            return false;
+        np = krealloc(plug, struct_size(np, sk, cap),
+                      GFP_KERNEL | __GFP_NOWARN);
+        if (!np)
+            return false;
+        if (!plug)
+            np->nr = 0;
+        np->cap = cap;
+        tsk->pre_gso_plug = np;
+        plug = np;
+        /* krealloc() may have slept and flushed: re-check the slot. */
+        if (plug->nr == plug->cap)
+            return false;
+    }
+
+    sock_hold(sk);
+    plug->sk[plug->nr++] = sk;
+    WRITE_ONCE(tp->pre_gso_plug_owner, tsk);
+    return true;
+}
+
+/*
+ * Called from sched_submit_work() when @tsk (== current) is about to block
+ * voluntarily.  Must not sleep: uses the same bh_lock_sock / deferred
+ * pattern as the TCP timers, so a socket owned by a user context (possibly
+ * this very task, e.g. a page fault inside sendmsg) is flushed from
+ * tcp_release_cb() instead.
+ */
+void tcp_pre_gso_flush_plug(struct task_struct *tsk)
+{
+    struct tcp_pre_gso_plug *plug = tsk->pre_gso_plug;
+    unsigned int i, nr;
+
+    if (!plug || !plug->nr)
+        return;
+
+    nr = plug->nr;
+    plug->nr = 0;
+    for (i = 0; i < nr; i++) {
+        struct sock *sk = plug->sk[i];
+
+        cmpxchg(&tcp_sk(sk)->pre_gso_plug_owner, tsk, NULL);
+
+        local_bh_disable();
+        bh_lock_sock(sk);
+        if (!sock_owned_by_user(sk))
+            tcp_pre_gso_flush_handler(sk);
+        else if (!test_and_set_bit(TCP_PRE_GSO_FLUSH_DEFERRED,
+                                   &sk->sk_tsq_flags))
+            sock_hold(sk);
+        bh_unlock_sock(sk);
+        local_bh_enable();
+
+        sock_put(sk);   /* reference taken by tcp_pre_gso_plug_add() */
+    }
+}
+
+/* do_exit(): flush what is left and release the plug itself. */
+void tcp_pre_gso_plug_exit(struct task_struct *tsk)
+{
+    struct tcp_pre_gso_plug *plug;
+
+    tcp_pre_gso_flush_plug(tsk);
+    plug = tsk->pre_gso_plug;
+    tsk->pre_gso_plug = NULL;
+    kfree(plug);
+}
+
