diff --git a/include/net/tcp_pre_gso.h b/include/net/tcp_pre_gso.h
new file mode 100644
index 000000000000..722a14841cab
--- /dev/null
+++ b/include/net/tcp_pre_gso.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Pre-GSO burst-end detection ("sleep flush").
+ *
+ * The paper defines aggregation_end as firing at the conclusion of a
+ * message burst or when the time window expires.  Without application
+ * changes the kernel cannot be told that a burst ended, so it infers it:
+ * a burst is over when the sending task voluntarily blocks (epoll_wait,
+ * recv, futex, sndbuf wait, ...).  Involuntary preemption -- e.g. by
+ * softirq / ksoftirqd on a contended core -- is NOT a burst end, so
+ * aggregation is preserved exactly where Pre-GSO is meant to help.
+ *
+ * Mechanism mirrors the block layer plug: each task that stages Pre-GSO
+ * bytes records the socket in a private per-task list, and the scheduler
+ * flushes that list from sched_submit_work() when the task goes to sleep.
+ * Only the owning task adds or removes entries, so the list needs no lock.
+ */
+#ifndef _NET_TCP_PRE_GSO_H
+#define _NET_TCP_PRE_GSO_H
+
+#include <linux/sched.h>
+
+struct sock;
+
+struct tcp_pre_gso_plug {
+	unsigned int	nr;
+	unsigned int	cap;
+	struct sock	*sk[];	/* each entry holds a socket reference */
+};
+
+#ifdef CONFIG_INET
+void tcp_pre_gso_flush_plug(struct task_struct *tsk);
+void tcp_pre_gso_plug_exit(struct task_struct *tsk);
+
+static inline bool tcp_pre_gso_needs_flush_plug(struct task_struct *tsk)
+{
+	struct tcp_pre_gso_plug *plug = tsk->pre_gso_plug;
+
+	return plug && plug->nr;
+}
+#else
+static inline void tcp_pre_gso_flush_plug(struct task_struct *tsk) { }
+static inline void tcp_pre_gso_plug_exit(struct task_struct *tsk) { }
+static inline bool tcp_pre_gso_needs_flush_plug(struct task_struct *tsk)
+{
+	return false;
+}
+#endif
+
+#endif /* _NET_TCP_PRE_GSO_H */
