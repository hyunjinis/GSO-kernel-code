 /*
- * EXPERIMENTAL dynamic skb linear tail growth.
- * Invariants: socket-memory accounting is updated by the actual truesize
- * delta following expansion. This is not a production-audited replacement
- * for the full TCP memory and skb lifecycle machinery.
+ * Page-frag staging.  One application message is accepted atomically:
+ * either all of its bytes are appended to the staging skb, or the skb is
+ * restored to its previous state (frags, lengths, socket memory charge)
+ * and the iterator is rewound.  This keeps "one send() == one message"
+ * and the Virtual Split return value exact even when a copy faults or
+ * memory runs out half-way through a message.
  */
-static int tcp_pre_gso_grow_staging(struct sock *sk,
-                                   struct sk_buff *skb, size_t needed,
-                                   size_t max_batch)
+struct tcp_pre_gso_snap {
+    unsigned int len;
+    int nr_frags;
+    unsigned int last_frag_size;
+};
+
+static void tcp_pre_gso_snap_take(const struct sk_buff *skb,
+                                  struct tcp_pre_gso_snap *snap)
 {
-    size_t available = skb_availroom(skb);
-    size_t target, growth;
-    unsigned int old_truesize;
-    int ret;
+    const struct skb_shared_info *shi = skb_shinfo(skb);
 
-    if (available >= needed)
-        return 0;
-    if ((size_t)skb->len + needed > max_batch)
-        return -EMSGSIZE;
+    snap->len = skb->len;
+    snap->nr_frags = shi->nr_frags;
+    snap->last_frag_size = shi->nr_frags ?
+        skb_frag_size(&shi->frags[shi->nr_frags - 1]) : 0;
+}
+
+/* Undo appends made after @snap.  Mirrors skb_copy_to_page_nocache(),
+ * which charged len/data_len/truesize/wmem_queued/forward_alloc by the
+ * copied byte count, and skb_fill_page_desc(), which took a page ref.
+ */
+static void tcp_pre_gso_rollback(struct sock *sk, struct sk_buff *skb,
+                                 const struct tcp_pre_gso_snap *snap)
+{
+    struct skb_shared_info *shi = skb_shinfo(skb);
+    unsigned int delta = skb->len - snap->len;
+    int i;
+
+    for (i = snap->nr_frags; i < shi->nr_frags; i++)
+        skb_frag_unref(skb, i);
+    shi->nr_frags = snap->nr_frags;
+    if (snap->nr_frags)
+        skb_frag_size_set(&shi->frags[snap->nr_frags - 1],
+                          snap->last_frag_size);
+    if (!delta)
+        return;
+    skb->len -= delta;
+    skb->data_len -= delta;
+    skb->truesize -= delta;
+    sk_wmem_queued_add(sk, -(int)delta);
+    sk_mem_uncharge(sk, delta);
+}
 
-    /* Geometric growth is an implementation detail, not a message boundary. */
-    target = max_t(size_t, (size_t)skb->len + needed,
-                   max_t(size_t, TCP_PRE_GSO_INITIAL_BYTES,
-                         (size_t)skb->len + available) * 2);
-    target = min(target, max_batch);
-    growth = target - ((size_t)skb->len + available);
-    if (!growth || growth > INT_MAX)
-        return -ENOBUFS;
-
-    if (!sk_stream_memory_free(sk) || !sk_wmem_schedule(sk, growth))
-        return -ENOBUFS;
-
-    old_truesize = skb->truesize;
-    atomic64_inc(&pre_gso_dyn_stat_expand_calls);
-    ret = pskb_expand_head(skb, 0, (int)growth, sk->sk_allocation);
-    if (ret) {
-        atomic64_inc(&pre_gso_dyn_stat_expand_fail);
-        return ret;
+/* Copy @size bytes from @msg into page frags of @skb.  Same steps and
+ * accounting as the !zc branch of tcp_sendmsg_locked().  Returns 0, or
+ * -EFAULT (bad user buffer), -E2BIG (frag budget of this skb exhausted),
+ * -ENOBUFS (no page or no socket memory).  On error, nothing is appended
+ * and @msg's iterator is unchanged.
+ */
+static int tcp_pre_gso_copy_frags(struct sock *sk, struct sk_buff *skb,
+                                  struct msghdr *msg, size_t size)
+{
+    int max_frags = READ_ONCE(sysctl_max_skb_frags);
+    struct tcp_pre_gso_snap snap;
+    size_t left = size;
+    int err = 0;
+
+    tcp_pre_gso_snap_take(skb, &snap);
+    while (left) {
+        struct page_frag *pfrag = sk_page_frag(sk);
+        int i = skb_shinfo(skb)->nr_frags;
+        bool merge = true;
+        int copy;
+
+        if (!sk_page_frag_refill(sk, pfrag)) {
+            err = -ENOBUFS;
+            break;
+        }
+        if (!skb_can_coalesce(skb, i, pfrag->page, pfrag->offset)) {
+            if (i >= max_frags) {
+                err = -E2BIG;
+                break;
+            }
+            merge = false;
+        }
+        copy = min_t(size_t, left, pfrag->size - pfrag->offset);
+        if (!sk_wmem_schedule(sk, copy)) {
+            err = -ENOBUFS;
+            break;
+        }
+        /* Full-or-nothing: on -EFAULT the iterator is not advanced. */
+        err = skb_copy_to_page_nocache(sk, &msg->msg_iter, skb,
+                                       pfrag->page, pfrag->offset, copy);
+        if (err)
+            break;
+        if (merge) {
+            skb_frag_size_add(&skb_shinfo(skb)->frags[i - 1], copy);
+        } else {
+            skb_fill_page_desc(skb, i, pfrag->page, pfrag->offset, copy);
+            page_ref_inc(pfrag->page);
+        }
+        pfrag->offset += copy;
+        left -= copy;
     }
 
-    /* pskb_expand_head() has already mutated skb on success: never
-     * return before reconciling its new accounting. TCP staging is
-     * linear and normal expansion must not shrink true size.
-     */
-    if (WARN_ON_ONCE(skb->truesize < old_truesize))
-        return -EIO;
-    if (skb->truesize != old_truesize) {
-        sk_wmem_queued_add(sk, skb->truesize - old_truesize);
-        sk_mem_charge(sk, skb->truesize - old_truesize);
+    if (err) {
+        tcp_pre_gso_rollback(sk, skb, &snap);
+        iov_iter_revert(&msg->msg_iter, size - left);
     }
-    return (size_t)skb_availroom(skb) >= needed ? 0 : -ENOBUFS;
+    return err;
 }
 
