@@ -1698,48 +1757,50 @@ static ssize_t tcp_pre_gso_append_locked(struct sock *sk,
     if (!skb) {
         if (!sk_stream_memory_free(sk))
             goto wait_for_space;
-        /* Predict a useful initial size from the N target and the actual
