+			if (tp->pre_gso_skb)
+				tcp_pre_gso_commit_locked(sk);
 			tp->repair = 1;
 			sk->sk_reuse = SK_FORCE_REUSE;
 			tp->repair_queue = TCP_NO_QUEUE;
