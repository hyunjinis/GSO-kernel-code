-        {
-            size_t n = max_t(u32, 1, READ_ONCE(
-                sock_net(sk)->ipv4.sysctl_tcp_pre_gso_n));
-
-            initial_bytes = min_t(size_t, max_batch,
-                 size * min_t(size_t, n, max_batch / size));
-            initial_bytes = max_t(size_t, initial_bytes,
-                 min_t(size_t, TCP_PRE_GSO_INITIAL_BYTES, max_batch));
-        }
-        skb = sk_stream_alloc_skb(sk, initial_bytes, sk->sk_allocation,
-                                  false);
+        skb = sk_stream_alloc_skb(sk, 0, sk->sk_allocation, false);
         if (!skb)
             goto wait_for_space;
         skb->ip_summed = CHECKSUM_PARTIAL;
         skb_shinfo(skb)->gso_size = 0;
         tp->pre_gso_skb = skb;
+        /* Charged once here, never again at commit (see commit_locked). */
         sk_wmem_queued_add(sk, skb->truesize);
         sk_mem_charge(sk, skb->truesize);
     }
 
     first_byte = !skb->len;
-    err = tcp_pre_gso_grow_staging(sk, skb, size, max_batch);
+    err = tcp_pre_gso_copy_frags(sk, skb, msg, size);
     if (err) {
-        if (skb->len) {
+        bool had_data = skb->len;
+
+        if (err == -EFAULT) {
+            /* Like TCP with nothing copied: report the fault; older
+             * staged bytes stay staged and keep their own triggers.
+             */
+            if (!had_data)
+                tcp_pre_gso_discard_locked(sk);
+            return err;
+        }
+        /* No room in this skb, or no memory: send what is staged (which
+         * also lets ACKs free memory), then retry the whole message.
+         */
+        if (had_data) {
             atomic64_inc(&pre_gso_dyn_stat_grow_fail_commit);
             tcp_pre_gso_commit_locked(sk);
         } else {
             tcp_pre_gso_discard_locked(sk);
+            /* A fresh skb has a full frag budget and size <= max_batch
+             * needs at most max_batch/PAGE_SIZE + 1 frags.
+             */
+            if (WARN_ON_ONCE(err == -E2BIG))
+                return -ENOBUFS;
         }
-        if (err == -ENOBUFS || err == -ENOMEM)
-            goto wait_for_space;
-        return err;
-    }
-    err = skb_add_data_nocache(sk, skb, &msg->msg_iter, size);
-    if (err) {
-        if (!skb->len)
-            tcp_pre_gso_discard_locked(sk);
-        return err;
+        if (err == -E2BIG)
+            goto retry;
+        goto wait_for_space;
     }
     atomic64_add(size, &pre_gso_dyn_stat_accepted);
     WRITE_ONCE(tp->pre_gso_bytes, skb->len);
@@ -1770,6 +1831,17 @@ static ssize_t tcp_pre_gso_append_locked(struct sock *sk,
     return size;
 
 wait_for_space:
+    /* Never sleep on socket memory while holding staged bytes: they are
+     * charged but not in flight, so no ACK could ever free them.
+     */
+    if (tp->pre_gso_skb) {
+        if (tp->pre_gso_skb->len) {
+            atomic64_inc(&pre_gso_dyn_stat_grow_fail_commit);
+            tcp_pre_gso_commit_locked(sk);
+        } else {
+            tcp_pre_gso_discard_locked(sk);
+        }
+    }
     if (sk->sk_socket)
         set_bit(SOCK_NOSPACE, &sk->sk_socket->flags);
     err = sk_stream_wait_memory(sk, timeo);
@@ -4143,6 +4215,11 @@ static int do_tcp_setsockopt(struct sock *sk, int level, int optname,
 		if (!tcp_can_repair_sock(sk))
 			err = -EPERM;
 		else if (val == TCP_REPAIR_ON) {
+			/* Checkpoint tools (CRIU) dump only the TCP write queue:
+			 * move staged Pre-GSO bytes there before repair begins.
