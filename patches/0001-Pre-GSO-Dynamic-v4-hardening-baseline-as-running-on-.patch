+/*
+ * EXPERIMENTAL Linux v5.15 Pre-GSO A-design core (N + hrtimer).
+ * This file is inserted into net/ipv4/tcp.c before tcp_sendmsg_locked().
+ * DO NOT DEPLOY: see README.md, especially lifetime and sendmsg parity.
+ */
+/* Dynamic staging is bounded by the actual GSO payload size.  A single
+ * application write larger than this bound uses unmodified TCP, after
+ * committing any older pending bytes.  It is NOT counted as many messages.
+ * The cap is a safety ceiling, NOT an aggregation/virtual-message unit.
+ */
+#define TCP_PRE_GSO_INITIAL_BYTES 4096U
+
+static size_t tcp_pre_gso_batch_limit(const struct sock *sk)
+{
+    unsigned int gso_max = READ_ONCE(sk->sk_gso_max_size);
+
+    if (gso_max <= MAX_TCP_HEADER + 1)
+        return 0;
+    /* Do not exceed one legal GSO payload or the per-skb size budget. */
+    return min_t(size_t, (size_t)gso_max - 1 - MAX_TCP_HEADER,
+                 (size_t)60 * 1024);
+}
+
+/* Research-only diagnostic counters: system-wide, not per netns.
+ * Compare deltas between adjacent debugfs reads during an isolated run.
+ * Approximate other commits = commits - N - timer - size - grow_fail.
+ */
+static atomic64_t pre_gso_dyn_stat_commits = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_n = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_timer = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_size = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_grow_fail_commit = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_bytes = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_messages = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_accepted = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_expand_calls = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_expand_fail = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_oversize_bypass = ATOMIC64_INIT(0);
+/* Bytes accepted in the private staging skb but later abandoned by TCP.
+ * Not a measure of end-to-end delivery or application-visible data loss.
+ */
+static atomic64_t pre_gso_dyn_stat_abandoned_bytes = ATOMIC64_INIT(0);
+static atomic64_t pre_gso_dyn_stat_abandoned_batches = ATOMIC64_INIT(0);
+
+static int tcp_pre_gso_dynamic_stats_show(struct seq_file *m, void *unused)
+{
+    u64 commits = atomic64_read(&pre_gso_dyn_stat_commits);
+    u64 n = atomic64_read(&pre_gso_dyn_stat_n);
+    u64 timer = atomic64_read(&pre_gso_dyn_stat_timer);
+    u64 size = atomic64_read(&pre_gso_dyn_stat_size);
+    u64 grow_fail = atomic64_read(&pre_gso_dyn_stat_grow_fail_commit);
+
+    seq_printf(m, "commits %llu\n", (unsigned long long)commits);
+    seq_printf(m, "commit_n %llu\n", (unsigned long long)n);
+    seq_printf(m, "commit_timer %llu\n", (unsigned long long)timer);
+    seq_printf(m, "commit_size_limit %llu\n", (unsigned long long)size);
+    seq_printf(m, "commit_grow_fail %llu\n", (unsigned long long)grow_fail);
+    seq_printf(m, "commit_other_approx %lld\n",
+        (long long)commits-(long long)n-(long long)timer-
+        (long long)size-(long long)grow_fail);
+    seq_printf(m, "committed_bytes %llu\n",
+        (unsigned long long)atomic64_read(&pre_gso_dyn_stat_bytes));
+    seq_printf(m, "committed_messages %llu\n",
+        (unsigned long long)atomic64_read(&pre_gso_dyn_stat_messages));
+    seq_printf(m, "accepted_bytes %llu\n",
+        (unsigned long long)atomic64_read(&pre_gso_dyn_stat_accepted));
+    seq_printf(m, "skb_expand_attempts %llu\n",
+        (unsigned long long)atomic64_read(&pre_gso_dyn_stat_expand_calls));
+    seq_printf(m, "skb_expand_fail %llu\n",
+        (unsigned long long)atomic64_read(&pre_gso_dyn_stat_expand_fail));
+    seq_printf(m, "oversize_bypass %llu\n",
+        (unsigned long long)atomic64_read(&pre_gso_dyn_stat_oversize_bypass));
+    seq_printf(m, "abandoned_staging_bytes %llu\n",
+        (unsigned long long)atomic64_read(&pre_gso_dyn_stat_abandoned_bytes));
+    seq_printf(m, "abandoned_staging_batches %llu\n",
+        (unsigned long long)atomic64_read(&pre_gso_dyn_stat_abandoned_batches));
+    return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(tcp_pre_gso_dynamic_stats);
+static int __init tcp_pre_gso_dynamic_stats_init(void)
+{
+    debugfs_create_file("tcp_pre_gso_dynamic_stats", 0444, NULL, NULL,
+                        &tcp_pre_gso_dynamic_stats_fops);
+    return 0;
+}
+late_initcall(tcp_pre_gso_dynamic_stats_init);
+
+static bool tcp_pre_gso_eligible(struct sock *sk,
+                                 const struct msghdr *msg, size_t size,
+                                 u16 tsflags, int size_goal)
+{
+    const struct tcp_sock *tp = tcp_sk(sk);
+    int flags = msg->msg_flags;
+
+    /* A single application call is either accepted atomically into one
+     * pending skb, or sent by the unmodified TCP path.  This prevents
+     * counting one large send() as several N-batch messages. */
+    if (!size || !size_goal || tp->pre_gso_bypass ||
+        !sock_net(sk)->ipv4.sysctl_tcp_pre_gso_enabled)
+        return false;
+    if (size > tcp_pre_gso_batch_limit(sk)) {
+        atomic64_inc(&pre_gso_dyn_stat_oversize_bypass);
+        return false;
+    }
+    /* Safety gate: never alter host-network TCP (SSH, kubelet, etc.).
+     * Experiment can be enabled only inside an isolated netns, e.g. p1. */
+    if (sock_net(sk) == &init_net)
+        return false;
+    if (sk->sk_state != TCP_ESTABLISHED && sk->sk_state != TCP_CLOSE_WAIT)
+        return false;
+    if (tp->repair || inet_sk(sk)->defer_connect)
+        return false;
+    /* Reject all special per-call semantics except nonblocking/nosignal. */
+    if (flags & ~(MSG_DONTWAIT | MSG_NOSIGNAL))
+        return false;
+    if (msg->msg_controllen || tsflags || (tp->nonagle & TCP_NAGLE_CORK))
+        return false;
+    if (inet_csk_has_ulp(sk))
+        return false;
+    return true;
+}
+
+/*
+ * Invariant: a pending skb is owned and socket-memory-accounted exactly
+ * once, but is NOT present on TCP's write queue and has NO TCP sequence.
+ * Called under the TCP socket lock.
+ */
+void tcp_pre_gso_discard_locked(struct sock *sk)
+{
+    struct tcp_sock *tp = tcp_sk(sk);
+    struct sk_buff *skb = tp->pre_gso_skb;
+
+    tp->pre_gso_skb = NULL;
+    tp->pre_gso_msgs = 0;
+    tp->pre_gso_target_n = 0;
+    WRITE_ONCE(tp->pre_gso_bytes, 0);
+    WRITE_ONCE(tp->pre_gso_deadline_ns, 0);
+    if (skb) {
+        int canceled;
+
+        atomic64_inc(&pre_gso_dyn_stat_abandoned_batches);
+        atomic64_add(skb->len, &pre_gso_dyn_stat_abandoned_bytes);
+        /* Cancellation with >0 transfers the armed timer's socket ref
+         * to us. With -1, the running callback owns that ref instead.
+         */
+        canceled = hrtimer_try_to_cancel(&tp->pre_gso_timer);
+        if (canceled > 0)
+            sock_put(sk);
+        sk_wmem_free_skb(sk, skb);
+    }
+}
+
+/* Called under the TCP socket lock. No allocation or copying. */
+static void tcp_pre_gso_commit_locked(struct sock *sk)
+{
+    struct tcp_sock *tp = tcp_sk(sk);
+    struct sk_buff *skb = tp->pre_gso_skb;
+    struct tcp_skb_cb *tcb;
+    int size_goal, mss_now;
+
+    if (!skb)
+        return;
+    if (WARN_ON_ONCE(!skb->len)) {
+        tcp_pre_gso_discard_locked(sk);
+        return;
+    }
+
+    /* The timer holds one socket ref until canceled or callback completion. */
+    if (hrtimer_try_to_cancel(&tp->pre_gso_timer) > 0)
+        sock_put(sk);
+
+    atomic64_inc(&pre_gso_dyn_stat_commits);
+    atomic64_add(skb->len, &pre_gso_dyn_stat_bytes);
+    atomic64_add(tp->pre_gso_msgs, &pre_gso_dyn_stat_messages);
+    /* Transfer ownership: the skb cannot be in both queues. */
+    tp->pre_gso_skb = NULL;
+    tp->pre_gso_msgs = 0;
+    tp->pre_gso_target_n = 0;
+    WRITE_ONCE(tp->pre_gso_bytes, 0);
+    WRITE_ONCE(tp->pre_gso_deadline_ns, 0);
+
+    tcb = TCP_SKB_CB(skb);
+    memset(tcb, 0, sizeof(*tcb));
+    skb->csum = 0;
+    tcb->seq = tp->write_seq;
+    tcb->end_seq = tp->write_seq + skb->len;
+    tcb->tcp_flags = TCPHDR_ACK;
+    tcb->sacked = 0;
+    tcp_skb_pcount_set(skb, 0);
+    __skb_header_release(skb);
+    tcp_add_write_queue_tail(sk, skb);
+    WRITE_ONCE(tp->write_seq, tcb->end_seq);
+
+    /* Memory was already charged at acceptance, not here. */
+    if (tp->nonagle & TCP_NAGLE_PUSH)
+        tp->nonagle &= ~TCP_NAGLE_PUSH;
+    tcp_slow_start_after_idle_check(sk);
+
+    mss_now = tcp_send_mss(sk, &size_goal, 0);
+    tcp_push(sk, 0, mss_now, tp->nonagle, size_goal);
+}
+
+/*
+ * EXPERIMENTAL dynamic skb linear tail growth.
+ * Invariants: socket-memory accounting is updated by the actual truesize
+ * delta following expansion. This is not a production-audited replacement
+ * for the full TCP memory and skb lifecycle machinery.
+ */
+static int tcp_pre_gso_grow_staging(struct sock *sk,
+                                   struct sk_buff *skb, size_t needed,
+                                   size_t max_batch)
+{
+    size_t available = skb_availroom(skb);
+    size_t target, growth;
+    unsigned int old_truesize;
+    int ret;
+
+    if (available >= needed)
+        return 0;
+    if ((size_t)skb->len + needed > max_batch)
+        return -EMSGSIZE;
+
+    /* Geometric growth is an implementation detail, not a message boundary. */
+    target = max_t(size_t, (size_t)skb->len + needed,
+                   max_t(size_t, TCP_PRE_GSO_INITIAL_BYTES,
+                         (size_t)skb->len + available) * 2);
+    target = min(target, max_batch);
+    growth = target - ((size_t)skb->len + available);
+    if (!growth || growth > INT_MAX)
+        return -ENOBUFS;
+
+    if (!sk_stream_memory_free(sk) || !sk_wmem_schedule(sk, growth))
+        return -ENOBUFS;
+
+    old_truesize = skb->truesize;
+    atomic64_inc(&pre_gso_dyn_stat_expand_calls);
+    ret = pskb_expand_head(skb, 0, (int)growth, sk->sk_allocation);
+    if (ret) {
+        atomic64_inc(&pre_gso_dyn_stat_expand_fail);
+        return ret;
+    }
+
+    /* pskb_expand_head() has already mutated skb on success: never
+     * return before reconciling its new accounting. TCP staging is
+     * linear and normal expansion must not shrink true size.
+     */
+    if (WARN_ON_ONCE(skb->truesize < old_truesize))
+        return -EIO;
+    if (skb->truesize != old_truesize) {
+        sk_wmem_queued_add(sk, skb->truesize - old_truesize);
+        sk_mem_charge(sk, skb->truesize - old_truesize);
+    }
+    return (size_t)skb_availroom(skb) >= needed ? 0 : -ENOBUFS;
+}
+
+/* Each eligible application sendmsg() invocation counts as ONE logical
+ * message, independently of its byte length or skb allocation capacity.
+ * Successful return is the original byte count accepted into kernel memory;
+ * no change to TCP's existing recv() byte-stream semantics is claimed.
+ */
+static ssize_t tcp_pre_gso_append_locked(struct sock *sk,
+                                         struct msghdr *msg, size_t size,
+                                         long *timeo, int size_goal)
+{
+    struct tcp_sock *tp = tcp_sk(sk);
+    struct sk_buff *skb;
+    size_t max_batch = tcp_pre_gso_batch_limit(sk);
+    size_t initial_bytes;
+    bool first_byte;
+    u32 timeout_us;
+    int err;
+
+    (void)size_goal;
+    if (WARN_ON_ONCE(!size || size > max_batch))
+        return -EMSGSIZE;
+
+retry:
+    if (sk->sk_err || (sk->sk_shutdown & SEND_SHUTDOWN))
+        return -EPIPE;
+    if (sk->sk_state != TCP_ESTABLISHED && sk->sk_state != TCP_CLOSE_WAIT)
+        return -EPIPE;
+
+    skb = tp->pre_gso_skb;
+    if (skb && READ_ONCE(tp->pre_gso_deadline_ns) &&
+        ktime_get_ns() >= READ_ONCE(tp->pre_gso_deadline_ns)) {
+        atomic64_inc(&pre_gso_dyn_stat_timer);
+        tcp_pre_gso_commit_locked(sk);
+        skb = NULL;
+    }
+    if (skb && skb->len + size > max_batch) {
+        /* Safety boundary: unavoidable early Commit, not an N-trigger. */
+        atomic64_inc(&pre_gso_dyn_stat_size);
+        tcp_pre_gso_commit_locked(sk);
+        skb = NULL;
+    }
+    if (!skb) {
+        if (!sk_stream_memory_free(sk))
+            goto wait_for_space;
+        /* Predict a useful initial size from the N target and the actual
+         * first write; avoid repeated reallocations for fixed-size streams.
+         * Any later larger writes can still grow the staging buffer.
+         */
+        {
+            size_t n = max_t(u32, 1, READ_ONCE(
